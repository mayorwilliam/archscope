{
  "name": "archscope-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "vitest run",
    "test:e2e": "pnpm build && pnpm -C e2e test",
    "test:e2e:dashboard": "pnpm build && pnpm -C e2e test:dashboard",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "bench": "pnpm build && node e2e/bench/bench.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
