    "enhanced-resolve": "^5.18.1",
    "execa": "^9.6.0",
    "fastify": "^5.10.0",
    "get-tsconfig": "^4.10.1",
    "ignore": "^7.0.5",
    "mysql2": "^3.22.6",
    "pg": "^8.22.0",
    "picomatch": "^4.0.2",
    "piscina": "^5.2.0",
    "tree-sitter-wasms": "^0.1.12",
    "web-tree-sitter": "^0.25.6",
    "yaml": "^2.8.0",
    "zod": "^3.25.76"
