    "architecture",
    "visualization",
    "mcp",
    "static-analysis",
    "dependency-graph",
    "erd"
  ],
  "license": "MIT",
  "author": "Guillermo Eduardo Granados Davalos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayorwilliam/archscope.git"
  },
  "homepage": "https://github.com/mayorwilliam/archscope#readme",
  "bugs": {
    "url": "https://github.com/mayorwilliam/archscope/issues"
  },
  "type": "module",
  "bin": {
